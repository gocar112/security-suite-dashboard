# Runtime state - findings and triage are local to each deployment
data/
config.json
.env

# Vulnerability feed cache: keep the directory, never commit the payload
nvds/*
!nvds/.gitkeep

# Watched folder: keep the directory, never commit what lands in it
uploads/*
!uploads/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
